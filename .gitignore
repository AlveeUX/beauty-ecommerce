# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit real values; the example file is tracked
.env*
!.env.example

# local databases (dev + test) and uploads
/data/*
!/data/.gitkeep
/uploads/*
!/uploads/.gitkeep

# test output
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/visual/actual/
/tests/visual/diff/

# deployment tooling (local-only phase; see decision-log D-003)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshots written by tests/visual/*.mjs (regenerate with those scripts; 50+ MB)
/tests/visual/baselines/
