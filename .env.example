# Copy to .env for local overrides. Never commit real values.
# All values below are safe local defaults; no external services are used.

# SQLite file for development. Relative to the project root.
DATABASE_URL=./data/dev.db

# Test database (used by Playwright/Vitest). The reset script refuses any
# path that does not contain "test".
TEST_DATABASE_URL=./data/test.db

# Port used by the Playwright-managed server (kept apart from `npm run dev`).
E2E_PORT=3100
